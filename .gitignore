# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Data artifacts (generated, not source)
data/generated/
benchmarks/results/*.json
benchmarks/results/*.md
!benchmarks/results/.gitkeep

# Runs that back a published number ARE committed. Invariant I7 says no number
# appears anywhere unless a stored run produced it - and a run stored only on
# the laptop that ran it makes every published figure unverifiable by anybody
# else, which is the same thing as not storing it. Exploratory runs stay
# ignored; a run promoted to back a claim gets copied in here deliberately.
!benchmarks/results/published/
!benchmarks/results/published/**
ml/artifacts/
*.parquet
*.duckdb

# Infra
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local container volumes
.docker-data/
