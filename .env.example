# AxonFDE environment configuration.
# Copy to .env and adjust. The defaults below work for local development.
# .env is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
AXON_ENV=local                 # local | ci | demo | production
AXON_LOG_LEVEL=INFO
AXON_API_PORT=8000

# ---------------------------------------------------------------------------
# Application database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# Two roles on purpose, for the same reason the legacy system has two logins:
#   - axon      : owns the schema and runs migrations. A superuser locally.
#                 PostgreSQL does not apply table privileges to a superuser,
#                 so the append-only grants on audit_event would be silently
#                 inert if the application shared this role.
#   - axon_app  : what the application actually connects as. Holds INSERT and
#                 SELECT on audit_event and nothing more. Created by migration
#                 0002, so `poe migrate` must run before the app starts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=axon
POSTGRES_PASSWORD=axon_local_dev
POSTGRES_DB=axon
POSTGRES_APP_USER=axon_app
POSTGRES_APP_PASSWORD=axon_app_local_dev

# Small on purpose: the async engine multiplexes, and an oversized pool on a
# 1 GB container exhausts the server's connection slots rather than going
# faster.
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_COMMAND_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Audit chain
#
# Keys the chain with HMAC-SHA256 instead of bare SHA-256. This is the control
# that defeats a full rewrite: the key lives with the application and never
# with the database role, so an attacker holding database write access cannot
# compute a valid hash for a row they forged.
#
# Unset means an unkeyed chain, which detects partial tampering but verifies
# cleanly after an end-to-end rewrite. That is tolerable locally and fatal at
# startup in a deployed environment, which refuses to boot without it.
#
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
AXON_AUDIT_HMAC_KEY=

# ---------------------------------------------------------------------------
# Legacy enterprise system (SQL Server).
#
# Two logins on purpose:
#   - sa            : used ONLY by the seed script, which creates the schema,
#                     the vw_ai_* views and the restricted login.
#   - axon_ai_ro    : used by the application. Granted SELECT on the six
#                     vw_ai_* views and NOTHING else. An integration test
#                     asserts that reading a base table fails.
# ---------------------------------------------------------------------------
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=AxonERP
MSSQL_SA_PASSWORD=Axon_Local_Dev_1
MSSQL_RO_USER=axon_ai_ro
MSSQL_RO_PASSWORD=Axon_ReadOnly_Dev_1
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_CERT=yes
MSSQL_QUERY_TIMEOUT_SECONDS=5
MSSQL_MAX_ROWS=500

# ---------------------------------------------------------------------------
# Object store (MinIO locally, S3 in cloud - same API)
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=axonadmin
S3_SECRET_KEY=axon_local_dev
S3_BUCKET=axon-artifacts
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# LLM provider
#
# Leave ANTHROPIC_API_KEY unset to run entirely from recorded cassettes:
# `poe demo` and `poe test` work offline and cost nothing.
#
# AXON_LLM_MODE:
#   cassette  - replay recorded responses (default; deterministic, free)
#   record    - call the real API and record responses to cassettes
#   live      - call the real API without recording
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AXON_LLM_MODE=cassette
AXON_MODEL_REASONING=claude-opus-5     # hypotheses, actions, narrative
AXON_MODEL_EXTRACTION=claude-sonnet-5  # bulk VLM / document extraction
AXON_MODEL_JUDGE=claude-haiku-4-5      # benchmark LLM judges

# Hard spend ceiling. The process refuses to make a paid call once the day's
# recorded spend exceeds this. A careless benchmark loop can otherwise burn a
# month's budget in an hour.
AXON_DAILY_SPEND_LIMIT_USD=5.00

# ---------------------------------------------------------------------------
# Agent budgets (exceeding any of these escalates the incident to a human
# rather than letting the workflow spin)
# ---------------------------------------------------------------------------
AXON_MAX_STEPS=25
AXON_MAX_TOOL_CALLS=40
AXON_MAX_WALL_CLOCK_SECONDS=180
AXON_MAX_TOKENS_PER_INCIDENT=120000

# ---------------------------------------------------------------------------
# Authentication
#
# Phase 1 uses a local dev issuer with an HS256 secret so that Principal and
# role-based authorization are real from day one. Phase 7 swaps in OIDC.
# The dev token endpoint is hard-disabled unless AXON_ENV=local.
# ---------------------------------------------------------------------------
AXON_JWT_SECRET=dev-only-not-a-real-secret-change-me
AXON_JWT_ISSUER=axonfde-local
AXON_JWT_AUDIENCE=axonfde-api
AXON_JWT_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Observability
#
# Langfuse Cloud's free tier is the default: self-hosting v3+ needs ClickHouse
# and costs ~4 GB of RAM we do not have. Leave the keys blank to disable
# tracing entirely - the application runs fine without it.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=axonfde-api

# ---------------------------------------------------------------------------
# Streaming (Phase 2)
# ---------------------------------------------------------------------------
REDPANDA_BROKERS=localhost:9092
REDPANDA_PORT=9092
REDPANDA_ADMIN_PORT=9644
REDPANDA_CONSOLE_PORT=8080

# ---------------------------------------------------------------------------
# Simulation / evaluation
# ---------------------------------------------------------------------------
AXON_SCENARIO_PACK=pack_v1
AXON_DEFAULT_SEED=20260918
